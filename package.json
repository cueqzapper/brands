{
  "name": "@cueqzapper/brands",
  "version": "1.2.1",
  "description": "An open, evidence-aware Brand DNA format and task-context compiler for humans, tools and AI agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueqzapper/brands.git"
  },
  "homepage": "https://cueqzapper.github.io/brands/",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./validator": {
      "types": "./types/index.d.ts",
      "import": "./src/validator.mjs",
      "default": "./src/validator.mjs"
    },
    "./schema": "./schema/brand-dna.schema.json",
    "./project": {
      "types": "./types/index.d.ts",
      "import": "./src/project.mjs",
      "default": "./src/project.mjs"
    },
    "./project-schema": "./schema/brand-project.schema.json",
    "./profiles": "./profiles/task-profiles.json"
  },
  "bin": {
    "brand-dna": "./src/cli.mjs"
  },
  "files": [
    "src",
    "types",
    "schema",
    "profiles",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:examples": "node scripts/generate-fictional-examples.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "check": "node scripts/validate-examples.mjs",
    "test": "node --test",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
